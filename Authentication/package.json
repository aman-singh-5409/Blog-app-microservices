{
  "name": "authentication",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node .build/Index.js",
    "dev": "nodemon",
    "build": "tsc",
    "migration-gen": "ts-node ./../node_modules/typeorm/cli.js migration:create",
    "migration-auto-gen": "ts-node -r dotenv/config ./../node_modules/typeorm/cli.js migration:generate -d DataSource.ts",
    "migration-run": "ts-node -r dotenv/config ./../node_modules/typeorm/cli.js migration:run -d DataSource.ts",
    "migration-revert": "ts-node -r dotenv/config ./../node_modules/typeorm/cli.js migration:revert -d DataSource.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "inversify": "^6.2.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/jsonwebtoken": "^9.0.8"
  }
}
